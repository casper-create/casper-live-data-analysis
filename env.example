DERIV_CLIENT_ID=replace-with-your-registered-deriv-oauth-client-id
DERIV_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
# Optional private comma-separated Deriv account IDs that receive site-owner Premium UI access.
# Set this in Render's private environment settings; do not publish real account IDs in GitHub.
CASPER_PREMIUM_OWNER_IDS=
PORT=8080
# For deployment set NODE_ENV=production and use HTTPS for both the app and callback URL.
