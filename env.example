DERIV_CLIENT_ID=replace-with-your-registered-deriv-oauth-client-id
# 32+ random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=replace-with-a-long-random-string-at-least-32-chars
# Optional. Defaults to the address the server is reached on. Set it for custom domains.
# Production: set this to the exact HTTPS callback registered in Deriv, e.g. https://your-service.onrender.com/auth/callback
# Local development: http://localhost:8080/auth/callback
DERIV_REDIRECT_URI=
# Optional private comma-separated Deriv account IDs that receive site-owner Premium UI access.
CASPER_PREMIUM_OWNER_IDS=
PORT=8080
